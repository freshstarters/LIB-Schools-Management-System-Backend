# Platform. Copy to .env. Empty integration secrets stay empty until that story.
# Variables already exported in the process environment win over this file.

# Required. postgres:// or postgresql:// only.
SECRET_KEY=
DEBUG=false
ALLOWED_HOSTS=localhost,127.0.0.1
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/lib_sms

# Optional at startup. When set, it must be PostgreSQL.
# per_tenant provisioning uses it to CREATE DATABASE and CREATE ROLE.
# The role needs CREATEDB and CREATEROLE.
TENANCY_PG_ADMIN_URL=postgresql://USER:PASSWORD@localhost:5432/postgres

# Broker. Blank CELERY_BROKER_URL falls back to REDIS_URL.
# Blank CELERY_RESULT_BACKEND leaves the result backend unset.
REDIS_URL=redis://127.0.0.1:6379/0
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=

# Tenancy switches. Unset TENANCY_DB_MODE means shared.
# Unset TENANCY_ROUTING_MODE means header_path when DEBUG is true,
# and subdomain when DEBUG is false. Subdomain mode requires TENANCY_BASE_DOMAIN.
# TENANCY_DB_MODE: shared | per_tenant
# TENANCY_ROUTING_MODE: subdomain | header_path
TENANCY_DB_MODE=shared
TENANCY_ROUTING_MODE=header_path
TENANCY_BASE_DOMAIN=

# Fernet key for tenant database passwords.
# Required when TENANCY_DB_MODE=per_tenant. A non-empty value must be valid in every mode.
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TENANCY_CREDENTIAL_KEY=

# Comma-separated browser origins. Empty means no cross-origin allow.
CORS_ALLOWED_ORIGINS=

# PR-03 privacy notice
HOSTING_REGION=
DATA_CONTROLLER_NAME=

# Public Gojo app origin for invite and reset links. Blank omits the link.
GOJO_APP_ORIGIN=

# PR-04 Google Sign-In. VITE_GOOGLE_CLIENT_ID is read by the frontend.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
VITE_GOOGLE_CLIENT_ID=

# PR-05 object storage
STORAGE_BACKEND=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_ENDPOINT_URL=

# Local seed for Gojo staff. The command refuses to run unless DEBUG is true.
SEED_GOJO_PASSWORD=

# PR-06 email
EMAIL_HOST=
EMAIL_PORT=
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=

# PR-07 SMS
SMS_PROVIDER=
SMS_API_KEY=
SMS_USERNAME=
SMS_ACCOUNT_SID=
SMS_SENDER_ID=

# PR-08 WhatsApp
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=

# PR-09 AI Assist
AI_PROVIDER=
AI_API_KEY=
AI_MODEL=

# PR-11 Lonestar Cell MTN MoMo
MTN_MOMO_ENV=
MTN_MOMO_SUBSCRIPTION_KEY=
MTN_MOMO_API_USER=
MTN_MOMO_API_KEY=
MTN_MOMO_WEBHOOK_SECRET=

# PR-12 Orange Money Liberia
ORANGE_MONEY_ENV=
ORANGE_MONEY_CLIENT_ID=
ORANGE_MONEY_CLIENT_SECRET=
ORANGE_MONEY_MERCHANT_KEY=
ORANGE_MONEY_WEBHOOK_SECRET=

# PR-13 error tracking. VITE_SENTRY_DSN is read by the frontend.
SENTRY_DSN=
VITE_SENTRY_DSN=

# Backup encryption. Required later by the backup command.
BACKUP_ENCRYPTION_KEY=
